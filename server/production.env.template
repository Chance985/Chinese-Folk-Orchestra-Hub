# ============================================================
# Chinese Folk Orchestra Hub — production environment template
# Copy to server/production.env and fill in real values.
# NEVER commit this file to Git.
# ============================================================

# Node environment
NODE_ENV=production

# Express port (Nginx proxies to this)
PORT=4000

# Frontend origin (used for CORS — must match your actual domain)
CLIENT_ORIGIN=https://ratewku.org

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── URL ID encryption ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
URL_TOKEN_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── SQLite path ───────────────────────────────────────────────
# Absolute path is safest in production.
SQLITE_DB_PATH=/var/lib/ratewku/orchestra.sqlite

# ── Optional: log level ───────────────────────────────────────
LOG_LEVEL=warn
